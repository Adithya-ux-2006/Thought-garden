# Required unless FLASK_DEBUG=1. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///thought_garden.db
# 0.45 is the tuned default (see docs/SELF_AUDIT.md) - 0.7 was too strict
# and left most genuinely related notes disconnected in the garden graph.
SIMILARITY_THRESHOLD=0.45
KEYWORD_SIMILARITY_THRESHOLD=0.18
MAX_RELATED_NOTES=5
EMBEDDING_MODEL=all-MiniLM-L6-v2
UPLOAD_MAX_SIZE_MB=10
# Off by default. Set to 1 only on your own machine to enable Flask's
# debugger and auto-reloader (also allows running without SECRET_KEY).
FLASK_DEBUG=0
