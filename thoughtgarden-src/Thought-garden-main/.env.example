SECRET_KEY=dev-secret-key-change-in-production
DATABASE_URL=sqlite:///thought_garden.db
# 0.45 is the tuned default (see docs/SELF_AUDIT.md) - 0.7 was too strict
# and left most genuinely related notes disconnected in the garden graph.
SIMILARITY_THRESHOLD=0.45
KEYWORD_SIMILARITY_THRESHOLD=0.18
MAX_RELATED_NOTES=5
EMBEDDING_MODEL=all-MiniLM-L6-v2
UPLOAD_MAX_SIZE_MB=10
# Set to 0/false to disable Flask's debugger and auto-reloader (do this in
# any environment other than your own local machine).
FLASK_DEBUG=1